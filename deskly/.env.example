# ---------------------------------------------------------------------------
# Deskly — environment variables
# Copy to `.env` and fill in. Never commit `.env`.
# `npm run setup:mac` writes a working `.env` for you.
# ---------------------------------------------------------------------------

# --- Core (required) -------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deskly?schema=public"

# Signing key for session cookies and customer-portal tokens.
# Generate with: openssl rand -hex 32
APP_SECRET="change-me-openssl-rand-hex-32"

# Public base URL of this instance. Used to build portal + invite links.
APP_URL="http://localhost:3000"

# Browser-visible copies of the two values above. Must mirror APP_URL and
# EMAIL_DOMAIN — they are inlined into the client bundle at build time.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_EMAIL_DOMAIN="deskly.local"


# --- Email -----------------------------------------------------------------

# console | resend | postmark | smtp
# `console` writes .eml files to ./storage/outbox and needs no credentials —
# it is the default so the app works fully offline.
EMAIL_PROVIDER="console"

# Domain used to mint per-workspace support addresses:
#   support@<subdomain>.<EMAIL_DOMAIN>
EMAIL_DOMAIN="deskly.local"

# Shared secret the inbound webhook requires (?secret=... or X-Deskly-Secret).
INBOUND_WEBHOOK_SECRET="change-me-inbound-secret"

# EMAIL_PROVIDER=resend
RESEND_API_KEY=""

# EMAIL_PROVIDER=postmark
POSTMARK_SERVER_TOKEN=""

# EMAIL_PROVIDER=smtp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"


# --- Attachments -----------------------------------------------------------

# local | s3
STORAGE_DRIVER="local"
STORAGE_PATH="./storage/attachments"
MAX_ATTACHMENT_MB="10"

# STORAGE_DRIVER=s3
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""


# --- AI (optional) ---------------------------------------------------------
# Leave ANTHROPIC_API_KEY empty to disable AI features; the UI degrades
# gracefully and every other feature keeps working.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"


# --- Monitoring (optional) -------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
