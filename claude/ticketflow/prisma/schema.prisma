// TicketFlow — customer support ticket management
//
// Multi-tenancy note: every tenant-scoped model carries a denormalised
// `workspaceId`. That redundancy is deliberate — it lets the Prisma client
// extension in src/lib/db.ts enforce workspace isolation uniformly on *every*
// model without having to traverse relations. See DECISIONS.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum TicketStatus {
  OPEN
  PENDING
  ON_HOLD
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum Channel {
  EMAIL
  FORM
  MANUAL
  PORTAL
}

enum AuthorType {
  CUSTOMER
  AGENT
  SYSTEM
}

enum NotificationType {
  MENTION
  ASSIGNED
  SLA_WARNING
  SLA_BREACH
  CUSTOMER_REPLY
}

model Workspace {
  id            String   @id @default(cuid())
  name          String
  subdomain     String   @unique
  logoUrl       String?
  brandColor    String?  @default("#1e1e1e")
  timezone      String   @default("Asia/Kolkata")
  /// { mon: [{ start: "09:00", end: "18:00" }], ... } — see src/lib/business-hours.ts
  businessHours Json?
  /// Monotonic counter backing the human-readable per-workspace ticket number.
  ticketCounter Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users           User[]
  teams           Team[]
  customers       Customer[]
  tickets         Ticket[]
  messages        Message[]
  activities      Activity[]
  attachments     Attachment[]
  slaPolicies     SlaPolicy[]
  rules           AssignmentRule[]
  tags            Tag[]
  cannedResponses CannedResponse[]
  savedViews      SavedView[]
  invites         Invite[]
  notifications   Notification[]

  @@index([subdomain])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  avatarUrl    String?
  role         Role     @default(AGENT)
  isActive     Boolean  @default(true)
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teamId       String?
  team         Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedTickets Ticket[]         @relation("assignee")
  sessions        Session[]
  savedViews      SavedView[]
  cannedResponses CannedResponse[]
  notifications   Notification[]
  invitesSent     Invite[]         @relation("invitedBy")

  @@index([workspaceId])
  @@index([workspaceId, teamId])
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 of the opaque cookie token. The raw token is never stored.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Invite {
  id          String   @id @default(cuid())
  email       String
  role        Role     @default(AGENT)
  teamId      String?
  tokenHash   String   @unique
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedById String?
  invitedBy   User?    @relation("invitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Cursor for round-robin assignment within this team.
  rrCursor    Int      @default(0)
  createdAt   DateTime @default(now())

  members User[]
  tickets Ticket[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Customer {
  id          String   @id @default(cuid())
  email       String
  name        String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  tickets Ticket[]

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

model Ticket {
  id          String       @id @default(cuid())
  /// Human-readable, unique per workspace.
  number      Int
  subject     String
  status      TicketStatus @default(OPEN)
  priority    Priority     @default(NORMAL)
  channel     Channel
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?        @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  teamId      String?
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  tags       Tag[]
  messages   Message[]
  activities Activity[]

  // --- SLA bookkeeping (all UTC) ---
  firstResponseAt      DateTime?
  firstResponseDueAt   DateTime?
  firstResponseWarnedAt DateTime?
  firstResponseBreached Boolean  @default(false)
  resolutionDueAt      DateTime?
  resolutionWarnedAt   DateTime?
  resolutionBreached   Boolean   @default(false)
  /// Denormalised "next deadline that matters" — powers the Overdue filter and
  /// keeps the SLA worker's scan to a single indexed range query.
  slaDueAt             DateTime?

  resolvedAt DateTime?
  closedAt   DateTime?

  /// CSAT is stored for v2 reporting; the MVP ships no survey UI (see scope).
  csatScore Int?

  /// AI-suggested category, overridable by an agent.
  aiCategory  String?
  aiSummary   String?  @db.Text
  aiSummaryAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([workspaceId, assigneeId, status])
  @@index([workspaceId, slaDueAt])
  @@index([workspaceId, createdAt])
  @@index([customerId])
}

model Message {
  id          String     @id @default(cuid())
  ticketId    String
  ticket      Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorType  AuthorType
  /// userId when authorType = AGENT.
  authorId    String?
  authorName  String?
  body        String     @db.Text
  bodyHtml    String?    @db.Text
  isInternal  Boolean    @default(false)

  // --- Email threading (RFC 5322) ---
  emailMessageId  String?
  emailInReplyTo  String?
  emailReferences String? @db.Text

  attachments Attachment[]

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([workspaceId])
  @@index([emailMessageId])
}

model Activity {
  id          String    @id @default(cuid())
  ticketId    String
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId     String?
  actorName   String?
  /// STATUS_CHANGED | ASSIGNED | TAGGED | PRIORITY_CHANGED | ...
  type        String
  payload     Json
  createdAt   DateTime  @default(now())

  @@index([ticketId, createdAt])
  @@index([workspaceId])
}

model Attachment {
  id          String    @id @default(cuid())
  messageId   String
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url         String
  filename    String
  mimeType    String
  size        Int
  createdAt   DateTime  @default(now())

  @@index([messageId])
  @@index([workspaceId])
}

model SlaPolicy {
  id                   String    @id @default(cuid())
  workspaceId          String
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  priority             Priority
  firstResponseMinutes Int
  resolutionMinutes    Int
  /// When true, timers only advance during the workspace's business hours.
  businessHoursOnly    Boolean   @default(true)

  @@unique([workspaceId, priority])
  @@index([workspaceId])
}

model AssignmentRule {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  /// [{ field, op, value }, ...] — validated by src/lib/rules.ts
  conditions  Json
  /// [{ action, value }, ...]
  actions     Json
  /// Evaluation order, ascending.
  priority    Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, priority])
}

model Tag {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  color       String?
  createdAt   DateTime  @default(now())

  tickets Ticket[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model CannedResponse {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// null = workspace-wide, otherwise personal to that user.
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shortcode   String
  title       String
  body        String    @db.Text
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId, shortcode])
  @@index([workspaceId])
}

model SavedView {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// null = shared with the whole workspace.
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  /// Serialised inbox filter state — see src/lib/filters.ts
  filters     Json
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

model Notification {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  ticketId    String?
  title       String
  body        String?          @db.Text
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([userId, readAt])
  @@index([workspaceId])
}
