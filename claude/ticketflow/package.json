{
  "name": "ticketflow",
  "version": "0.1.0",
  "private": true,
  "description": "Customer support ticketing that a small team can run on day one.",
  "author": {
    "name": "TicketFlow"
  },
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --conditions=react-server --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run test:electron",
    "seed": "node --conditions=react-server --import tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "verify:isolation": "node --conditions=react-server --import tsx scripts/verify-isolation.ts",
    "worker": "node --conditions=react-server --import tsx scripts/worker.ts",
    "postinstall": "prisma generate",
    "dev:session": "node --conditions=react-server --import tsx scripts/dev-session.ts",
    "simulate:email": "node --conditions=react-server --import tsx scripts/simulate-inbound.ts",
    "verify:sla": "node --conditions=react-server --import tsx scripts/verify-sla.ts",
    "verify:routing": "node --conditions=react-server --import tsx scripts/verify-routing.ts",
    "verify": "npm run verify:isolation && npm run verify:sla && npm run verify:routing && npm run verify:ai",
    "verify:ai": "node --conditions=react-server --import tsx scripts/verify-ai.ts",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "electron": "electron electron/main.js",
    "desktop": "npm run build:desktop && npm run electron",
    "dist:mac": "npm run build:desktop && electron-builder --mac",
    "setup:mac": "bash scripts/mac-setup.sh",
    "test:electron": "node --test tests/electron/*.test.mjs",
    "icon": "node scripts/render-icon.mjs",
    "demo:video": "node scripts/record-demo.mjs",
    "demo:video:raw": "DEMO_CAPTIONS=off node scripts/record-demo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1105.0",
    "@date-fns/tz": "^1.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "nodemailer": "^9.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.17.6",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "dotenv": "^17.4.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
